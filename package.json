{
  "name": "@feneto/lh",
  "version": "1.3.1",
  "description": "AI harness framework for brownfield feature work with on-demand discovery, bounded context, multi-host adapters, CaveBus summaries, and verification evidence.",
  "repository": "https://github.com/fernandonetom/lean-harness",
  "type": "module",
  "bin": {
    "lh": "./dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./types": "./dist/core/types.js",
    "./adapters": "./dist/adapters/types.js",
    "./plugins": "./dist/plugins/types.js",
    "./config": "./dist/core/resolved-config.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    ".lh/templates",
    ".lh/protocols",
    ".lh/policies"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && rm -rf dist/commands/opencode-command-bundles && cp -r src/commands/opencode-command-bundles dist/commands/opencode-command-bundles",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "doctor": "node dist/index.js doctor",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "prepack": "npm run build && npm run typecheck && npm test",
    "pack:dry-run": "npm pack --dry-run",
    "release:check": "npm run build && npm run typecheck && npm test && npm run pack:dry-run",
    "release": "npm run release:check && npm publish --provenance --access public"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "keywords": [
    "ai",
    "agents",
    "coding-agent",
    "claude-code",
    "opencode",
    "brownfield",
    "specification",
    "verification",
    "cli",
    "harness",
    "on-demand-discovery",
    "bounded-context",
    "cavebus",
    "multi-host"
  ],
  "dependencies": {
    "@clack/prompts": "^1.4.0",
    "commander": "^15.0.0",
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^25.6.0",
    "vitest": "^3.2.1"
  }
}
